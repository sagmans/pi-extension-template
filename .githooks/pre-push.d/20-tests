#!/bin/sh
# Runs the unit tests and the link check on each pushed commit.
set -eu

checks() {
	python3 -m unittest discover -s test -p 'test_*.py' || return 1
	python3 scripts/check_links.py . || return 1
}

# Shared helpers (staged_git, pushed_shas, at_sha, darwin_only) from the dotf
# dispatcher, which also scrubs git's repository-local variables first.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?HOOK_HELPERS is not set: run this hook through the dotf git hooks dispatcher}"
# Repository helpers, loaded relative to this script (the reviewed copy).
# shellcheck source=../_lib/prepush.sh
. "$(dirname -- "$0")/../_lib/prepush.sh"
run_pushed

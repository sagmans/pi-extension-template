#!/usr/bin/env bash
# Runs ruff, mypy, shell checks, unit tests and the link check on each pushed
# commit. ruff and mypy come pinned from uv.lock through uv; missing tools block
# the push.
set -euo pipefail

readonly SUITE_TIMEOUT_SECONDS=600

for tool in uv shellcheck shfmt; do
	command -v "$tool" >/dev/null || {
		echo "pre-push: $tool is missing" >&2
		exit 1
	}
done

checks() {
	run_step 'python runtime policy' "$SUITE_TIMEOUT_SECONDS" bash scripts/check-python-runtime.sh || return 1
	run_step 'ruff format' "$SUITE_TIMEOUT_SECONDS" uv run --locked --quiet ruff format --check . || return 1
	run_step 'ruff lint' "$SUITE_TIMEOUT_SECONDS" uv run --locked --quiet ruff check . || return 1
	run_step 'mypy' "$SUITE_TIMEOUT_SECONDS" uv run --locked --quiet mypy scripts test || return 1
	run_step 'shell lint and format' "$SUITE_TIMEOUT_SECONDS" bash scripts/lint-shell.sh || return 1
	run_step 'unit tests' "$SUITE_TIMEOUT_SECONDS" uv run --no-project --python-preference only-managed python -m unittest discover -s test -p 'test_*.py' || return 1
	run_step 'link check' "$SUITE_TIMEOUT_SECONDS" uv run --no-project --python-preference only-managed python scripts/check_links.py . || return 1
}

# Helpers (staged_git, pushed_shas, at_sha, run_step, darwin_only) from .githooks/lib.
# shellcheck source=.githooks/lib/helpers.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

# Each pushed commit is tested as pushed: in place when it is a clean HEAD,
# otherwise in a temporary worktree. A for loop, never `| while`, so a failure
# blocks the push.
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
for pp_commit in $shas; do
	echo "pre-push: $(basename -- "$0"): checking $pp_commit" >&2
	if ! at_sha "$pp_commit" checks; then
		echo "pre-push: $(basename -- "$0"): checks failed for $pp_commit" >&2
		exit 1
	fi
done

# Copy to release.yml only in an adapted target after npm OIDC and environment approval setup.
name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  package:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          cache: false

      - run: npm ci --ignore-scripts

      - name: Tag must match package.json version
        run: test "v$(node -p 'require("./package.json").version')" = "$GITHUB_REF_NAME"

      # One package job owns bytes so verification and publication cannot diverge.
      - name: Pack artifact
        run: |
          mkdir -p artifact
          npm pack --pack-destination artifact

      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: npm-package
          path: artifact/*.tgz
          if-no-files-found: error
          retention-days: 1

  verify:
    needs: package
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          cache: false

      - run: npm ci --ignore-scripts
      # Source checks use pack dry-run; only the package job creates release bytes.
      - run: npm run audit && npm run verify

      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: npm-package
          path: artifact

      - name: Load verified artifact through Pi
        run: |
          set -- artifact/*.tgz
          test "$#" -eq 1 && test -f "$1"
          package="$PWD/$1"
          node scripts/smoke-package.mjs --tarball "$package"

  publish:
    needs: [package, verify]
    runs-on: ubuntu-latest
    environment: npm-release
    timeout-minutes: 10
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          cache: false

      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: npm-package
          path: artifact

      - name: Publish verified artifact
        env:
          NPM_CONFIG_REGISTRY: https://registry.npmjs.org
        run: |
          set -- artifact/*.tgz
          test "$#" -eq 1 && test -f "$1"
          package="$PWD/$1"
          npm publish "$package" --provenance --access public

{
	"name": "pi-extension-template",
	"version": "0.0.0",
	"private": true,
	"description": "Non-publishing executable reference blueprint for Pi extensions",
	"license": "MIT",
	"type": "module",
	"files": [
		"index.ts"
	],
	"exports": {
		".": "./index.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"audit": "node scripts/audit.mjs",
		"pack:verify": "node scripts/verify-package.mjs",
		"smoke": "node scripts/smoke-package.mjs",
		"verify": "npm run check && npm run typecheck && npm run test:coverage && npm run pack:verify",
		"verify:ci": "npm run audit && npm run verify && npm run smoke"
	},
	"engines": {
		"node": ">=24.20.0 <25"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "24.13.0",
		"@vitest/coverage-v8": "4.1.11",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
